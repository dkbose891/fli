# Auth — pick ONE:
# A) Cursor Cloud / no ADC: set GEMINI_API_KEY (Gemini Developer API). Preferred in cloud.
# B) Local Vertex: leave GEMINI_API_KEY unset; use ADC (`gcloud auth application-default login`).
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=australia-southeast1
GEMINI_MODEL=gemini-2.5-flash

# NSW Cadastre ArcGIS REST endpoint (public, anonymous)
CADASTRE_URL=https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Land_Parcel_Property_Theme/FeatureServer/8/query

# Addressr (RapidAPI-hosted) address search — key is a SECRET, set it in .env.local only
# ADDRESSR_RAPIDAPI_KEY=
